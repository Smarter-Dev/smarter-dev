{
  "name": "smarter-dev-media",
  "version": "1.0.0",
  "private": true,
  "description": "Internal media service: LaTeX rendering, audio transcode, Discord embed cards",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "fastify": "5.11.2",
    "mathjax": "3.2.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
