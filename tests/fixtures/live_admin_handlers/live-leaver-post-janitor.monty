async def run():
    # The forum or channel to check for threads
    target_channel_id = "1049001614922481755"
    leaver_id = context["member_id"]
    
    # 1. Fetch active threads in the target channel
    # This includes both regular threads and forum posts.
    threads = await list_threads(target_channel_id)
    
    # 2. Iterate and close posts owned by the leaver
    closed_count = 0
    for thread in threads:
        # Match owner and ensure it's not already archived
        if thread["owner_id"] == leaver_id and not thread["archived"]:
            thread_id = thread["thread_id"]
            
            # Post a notice into the thread before closing
            # Note: send_message(text, channel_id) works for threads
            await send_message(
                f"The author of this post (<@{leaver_id}>) has left the server. Closing post.",
                channel_id=thread_id
            )
            
            # Archive the thread
            await close_thread(thread_id)
            
            closed_count += 1
            
            # Respect the 5-post limit requested by the admin
            if closed_count >= 5:
                break

await run()

