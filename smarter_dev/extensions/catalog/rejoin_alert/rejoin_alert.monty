# Tell the mod team when someone with prior moderation history comes back.
#
# COST SHAPE (the reason this lives on member_join and nowhere else): the
# mod-action read is expensive, so it sits behind the join gate — ONE
# list_mod_actions call and AT MOST one report per join, never anything
# per-message. Bot joins short-circuit before the lookup, so an integration being
# added spends nothing. Joins burst during a raid; the dispatcher's
# member_join fires-per-minute ceiling bounds that, and this script adds no state
# of its own (no memory reads or writes, so nothing to prune or outgrow).
#
# The heads-up goes through report_for_review: a review-only incident in the
# moderation system (nothing is done to the member, and nothing counts against
# them), reported in the guild's incident report channel like every other
# incident. A member who rejoins again within the review window is not
# reported twice.
HISTORY_DEPTH = 5

if not context["is_bot"]:
    actions = await list_mod_actions(context["member_id"], HISTORY_DEPTH)
    if actions:
        # Rows come back newest-first, so row 0 is the most recent action. The
        # count is a floor, not a total (the read stops at HISTORY_DEPTH), hence
        # "n+". created_at is nullable on the row shape.
        most_recent = actions[0]
        acted_at = most_recent["created_at"]
        acted_on = acted_at[:10] if acted_at else "an unknown date"
        await report_for_review(
            context["member_id"],
            "Member rejoined — " + context["username"]
            + " has " + str(len(actions))
            + "+ prior mod actions, most recent: " + most_recent["action_type"]
            + " on " + acted_on,
        )
