FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first, then install uv. pip >= 26.2.2, uv >= 0.13.4 and
# certifi >= 2026.10.19 drop the emSign roots whose eMudhra intermediate keys
# were compromised (GHSA-6q48-6c7w-9gw2, Oct 2026); the base image ships an
# older pip.
RUN pip install --no-cache-dir --upgrade "pip>=26.2.2" \
    && pip install --no-cache-dir "uv>=0.13.4"

# Copy only dependency files first
COPY pyproject.toml uv.lock ./

# Install dependencies in production mode with web group
RUN uv sync --frozen --no-dev

# Copy only application code (exclude .venv and other unnecessary files)
COPY smarter_dev smarter_dev/
COPY skrift skrift/
COPY themes themes/
COPY templates templates/
COPY static static/
COPY main.py app.yaml ./
COPY alembic.ini ./
COPY alembic alembic/

# Create non-root user
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app
USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Run the web application
CMD ["uv", "run", "hypercorn", "main:app", "--bind", "0.0.0.0:8000"]