{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarter.dev/contracts/proactive/v1/notification.schema.json",
  "title": "Proactive notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notification_id",
    "guild_id",
    "channel_id",
    "channel_name",
    "kind",
    "created_at",
    "body",
    "message_ids",
    "wakes",
    "passive",
    "watcher_usage",
    "trace_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "notification_id": {"type": "string", "format": "uuid"},
    "guild_id": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "channel_id": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "channel_name": {"type": "string", "maxLength": 100},
    "kind": {
      "enum": [
        "mention",
        "reply_to_bot",
        "watcher_summary",
        "new_messages",
        "mode_change",
        "instruction_expired",
        "recovery",
        "reaction",
        "channel_enabled"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "body": {"type": "string"},
    "message_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9]{1,20}$"},
      "maxItems": 100
    },
    "wakes": {"type": "boolean"},
    "passive": {"type": "boolean"},
    "watcher_usage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_tokens", "output_tokens", "cache_read_tokens"],
        "properties": {
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "cache_read_tokens": {"type": "integer", "minimum": 0}
        }
      }
    },
    "trace_id": {"type": "string", "format": "uuid"}
  }
}
