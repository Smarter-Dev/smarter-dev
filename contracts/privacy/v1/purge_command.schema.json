{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarter.dev/contracts/privacy/v1/purge_command.schema.json",
  "title": "Privacy purge command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "user_id",
    "names",
    "guild_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "user_id": {"type": "string", "pattern": "^[0-9]{15,22}$"},
    "names": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "guild_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"type": "string", "pattern": "^[0-9]{15,22}$"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
