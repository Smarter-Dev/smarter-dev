{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "courses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blurb": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "first_indexed_at": {
            "format": "date",
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "source",
          "key",
          "tools",
          "first_indexed_at",
          "published_at",
          "blurb",
          "category"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "faqs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "source_label": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer",
          "source_label",
          "source_url",
          "source_key"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "people": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blurb": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "handle",
          "platform",
          "url",
          "key",
          "blurb"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stay_current_platforms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "home_key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "description",
          "url",
          "home_key"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "categories",
    "tools",
    "courses",
    "people",
    "stay_current_platforms",
    "faqs"
  ],
  "title": "agentic-coding-courses",
  "type": "object"
}
