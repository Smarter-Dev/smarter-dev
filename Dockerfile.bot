FROM python:3.13-slim

WORKDIR /app

# Install system dependencies. LaTeX rendering, audio transcode and card
# images all moved to the media service, so ffmpeg, nodejs and npm are gone
# along with Pillow's image/font codec headers. gcc builds wheels for the
# `bot` dependency group; procps provides pgrep for the health check.
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first, then install uv. pip >= 26.2.2, uv >= 0.13.4 and
# certifi >= 2026.10.19 drop the emSign roots whose eMudhra intermediate keys
# were compromised (GHSA-6q48-6c7w-9gw2, Oct 2026); the base image ships an
# older pip.
RUN pip install --no-cache-dir --upgrade "pip>=26.2.2" \
    && pip install --no-cache-dir "uv>=0.13.4"

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies in production mode with bot group
RUN uv sync --frozen --no-dev --group bot

# Copy application code
COPY . .

# Create non-root user
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app
USER app

# Health check (simple process check since bot doesn't have HTTP endpoint)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD pgrep -f "smarter_dev.bot.client" || exit 1

# Run straight from the venv baked at build time, the environment `uv run`
# would set up, without leaving a resident uv parent in the pod. run_bot
# installs its own SIGTERM handler, so the bot can run as PID 1.
ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"
CMD ["python", "-m", "smarter_dev.bot.client"]
