# Data. Never bake a database, dump or export into an image, even one that
# is only lying around untracked in a local checkout.
database_backup/
*.db
*.db3
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-*
*.sqlite3-*
*.dump
*.pgdump
*.backup
# Mirrors the backup/dump name rule in scripts/check_no_data_exports.py.
**/*backup*.json
**/*backup*.jsonl
**/*backup*.ndjson
**/*backup*.csv
**/*backup*.tsv
**/*backup*.sql
**/*backup*.gz
**/*backup*.zip
**/*backup*.tar
**/*backup*.tgz
**/*backup*.bz2
**/*backup*.xz
**/*backup*.zst
**/*dump*.json
**/*dump*.jsonl
**/*dump*.ndjson
**/*dump*.csv
**/*dump*.tsv
**/*dump*.sql
**/*dump*.gz
**/*dump*.zip
**/*dump*.tar
**/*dump*.tgz
**/*dump*.bz2
**/*dump*.xz
**/*dump*.zst

# OS
.DS_Store
Thumbs.db

# Documentation
README.md
*.md
docs/

# Planning
planning/
reports/

# GitHub
.github/

# Not used at runtime. This list must stay in sync with the tag-input
# excludes in .github/workflows/deploy.yaml: anything the image tag ignores
# must be out of the build context too, or the image could change without
# the tag changing.
k8s/
tests/
.claude/
_meta
# services/ builds its own images from its own scoped contexts (e.g.
# services/media), so it must never leak into the web/bot contexts.
services/

# Assets not needed in container
grow-together-landing-page.png
landing-page.html
static-logo-icon.png
static-logo-icon.svg
logo-icon.afdesign
resources/Discord*.png
resources/Discover*.png
resources/Invite*.png
resources/smarter-dev*.png
resources/streak.png
